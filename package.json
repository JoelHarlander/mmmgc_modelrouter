{
  "name": "pi-modelrouter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi extension: Jev-routed model selection with plan/on-demand cost awareness and N-way parallel responses",
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "eval": "tsx eval/cli.ts",
    "eval:all": "tsx eval/run-all.ts",
    "smoke": "cd test/smoke && pi -p --no-extensions --no-skills --no-prompt-templates --no-context-files --no-session --approve -e ../faux-provider.ext.ts -e ../../src/index.ts --provider faux --model a 'ls'"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
